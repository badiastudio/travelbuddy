{
  "expo": {
    "name": "Travel Buddy+",
    "slug": "travelPro",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "travelpro",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "supportsMacCatalyst": false,
      "config": {
        "googleMapsApiKey": "AIzaSyAw4_SkDhOOf3hMNyRnw2r4mG0Y21aCBKM"
      },
      "bundleIdentifier": "com.cshunnarah.travelPro",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "TravelPro uses your location to show where you are on the trip map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAw4_SkDhOOf3hMNyRnw2r4mG0Y21aCBKM"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.travelbuddyplus"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B8DCE8",
          "image": "./assets/travel-buddy-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-image-picker",
      "expo-document-picker",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "AIzaSyAw4_SkDhOOf3hMNyRnw2r4mG0Y21aCBKM"
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "4cb5d17f-4068-41e6-8421-58f80c24509a"
      }
    }
  }
}
